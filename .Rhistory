p1.adap <- p2.adap <- p3.adap <- c()
p1.static <- p2.static <- p3.static <- c()
for (t in (1:T0)) {
Xt <- rmultinom(1,1,pi)
j <- which(Xt==1)
pj.adap <- solution(j, rho)$p_j
cost.adap <- cost.adap + rbinom(1,1,pj.adap)
pj.static <- solution(j, rho0)$p_j
cost.static <- cost.static + rbinom(1,1,pj.static)
##save history
if (j == 1) {
p1.adap <- c(p1.adap,pj.adap)
p1.static <- c(p1.static, pj.static)
} else if (j == 2) {
p2.adap <- c(p2.adap,pj.adap)
p2.static <- c(p2.static, pj.static)
} else {
p3.adap <- c(p3.adap,pj.adap)
p3.static <- c(p3.static,pj.static)
}
tj.adap <- solution(j, rho)$tj
reward.adap <- reward.adap + sum(pi[1:tj.adap] * u[1:tj.adap]) +
solution(tj.adap+1, rho)$p_j * pi[tj.adap+1] * u[tj.adap+1]
tj.static <- solution(j, rho0)$tj
reward.static <- reward.static + sum(pi[1:tj.static] * u[1:tj.static]) +
solution(tj.static+1, rho0)$p_j * pi[tj.static+1] * u[tj.static+1]
#update rho
rho <- (B-cost.adap)/(T0-t)
}
return(list("p1.adap"=p1.adap, "p2.adap"=p2.adap, "p3.adap"=p3.adap,
"p1.static"=p1.static, "p2.static"=p2.static, "p3.static"=p3.static,
"reward.adap"=reward.adap, "reward.static"=reward.static,
"cost.adap"=cost.adap, "cost.static"=cost.static))
}
